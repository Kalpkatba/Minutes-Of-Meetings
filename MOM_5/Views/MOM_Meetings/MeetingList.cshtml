@model List<MOM_MeetingsModel>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title">Meetings</h4>
                    <a asp-controller="Meetings" asp-action="MeetingAddEdit" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Schedule Meeting
                    </a>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search meetings...">
                    </div>
                    <div class="col-md-3">
                        <select id="filterType" class="form-select">
                            <option value="">All Types</option>
                            @foreach (var mt in Model)
                            {
                                <option value="@mt.MeetingTypeID">@mt.MeetingTypeName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select id="filterDepartment" class="form-select">
                            <option value="">All Departments</option>
                            @foreach (var dept in Model)
                            {
                                <option value="@dept.DepartmentID">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select id="filterStatus" class="form-select">
                            <option value="">All Status</option>
                            <option value="upcoming">Upcoming</option>
                            <option value="completed">Completed</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                @if (Model != null && Model.Count > 0)
                {
                <div class="table-responsive">
                    <table class="table table-striped" id="meetingsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Date & Time</th>
                                <th>Type</th>
                                <th>Department</th>
                                <th>Venue</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meeting in Model)
                            {
                                var status = meeting.IsCancelled == true ? "Cancelled" : (meeting.MeetingDate > DateTime.Now ? "Upcoming" : "Completed");
                                <tr data-type="@meeting.MeetingTypeID" data-department="@meeting.DepartmentID" data-status="@status.ToLower()">
                                    <td>@meeting.MeetingID</td>
                                    <td>@meeting.MeetingDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(meeting?.MeetingTypeName ?? "N/A")</td>
                                    <td>@(meeting?.DepartmentName ?? "N/A")</td>
                                    <td>@(meeting?.MeetingVenueName ?? "N/A")</td>
                                    <td>@(meeting.MeetingDescription ?? "No description")</td>
                                    <td>
                                        @if (status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">@status</span>
                                        }
                                        else if (status == "Upcoming")
                                        {
                                            <span class="badge bg-warning">@status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@status</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="MOM_Meetings" asp-action="MeetingAddEdit" asp-route-id="@meeting.MeetingID" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-controller="MOM_Meetings" asp-action="DeleteMeeting" asp-route-id="@meeting.MeetingID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this meeting? This will also delete all related meeting members.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No Venue found. Click "Add New Venue" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}