@model MOM_DepartmentModel

<div class="row container-fluid">
    <div class="row-cols-lg-auto mx-auto">
        <div class="card shadow">
            <div class="card-header bg-theme-header fw-bold">
                <h4 class="card-title">
                    @(Model.DepartmentID == 0 ? "Add Department" : "Edit Department")
                </h4>
            </div>
            <div class="card-body">
                <form asp-controller="MOM_Department" asp-action="DepartmentSave" method="post">

                    <input type="hidden" asp-for="DepartmentID" />

                    <div class="mb-3">
                        <label asp-for="DepartmentName" class="form-label"> DepartmentName </label>
                        <span class="text-danger">*</span>
                        <input asp-for="DepartmentName" class="form-control" placeholder="Enter Department Name..."/>
                        <span asp-validation-for="DepartmentName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label> 
                        <textarea name="Remarks" class="form-control" rows="3" maxlength="500" placeholder="Enter Remarks...">@Model?.Remarks</textarea>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-theme fw-bold">
                            <i class="fas fa-save"></i> @(Model.DepartmentID > 0 ? "Update"
                                                        : "Save")
                        </button>
                        <a asp-controller="MOM_Department" asp-action="DepartmentList" class="btn btn-danger fw-bold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" /> 
}