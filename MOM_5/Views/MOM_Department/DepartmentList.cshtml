@model List<MOM_DepartmentModel>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title">Departments</h4>
                    <a asp-controller="MOM_Department" asp-action="DepartmentAddEdit" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Department
                    </a>
                </div>
                @if (Model != null && Model.Count > 0)
                {
                <div class="mb-3">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search departments...">
                </div>

                <div class="table-responsive">
                    <table class="table table-striped" id="departmentsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Department Name</th>
                                <th>Remarks</th>
                                <th>Created</th>
                                <th>Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model)
                            {
                                <tr>
                                    <td>@dept.DepartmentID</td>
                                    <td>@dept.DepartmentName</td>
                                    <td>@dept.Remarks</td>
                                    <td>@dept.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@dept.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                            <a asp-controller="MOM_Department" asp-action="AddEdit" asp-route-id="@dept.DepartmentID" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                            <form asp-controller="MOM_Department" asp-action="DeleteDepartment" asp-route-id="@dept.DepartmentID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this department?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @* Error Message *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No departments found. Click "Add New Department" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>