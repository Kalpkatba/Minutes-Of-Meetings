@model List<MOM_DepartmentModel>

<div class="row container-fluid">
    <div class="row-cols-lg-auto mx-auto">
        <div class="card shadow-lg">
            <div class="card-header bg-theme-header d-flex justify-content-between align-items-center fw-bold">
                <h4 class="card-title mb-0 ps-2">Departments</h4>

                <a asp-controller="MOM_Department" asp-action="DepartmentAddEdit" asp-route-id="" class="btn btn-theme-header fw-bold">
                    <i class="bi bi-plus-circle"></i> Add Department
                </a>
            </div>
            <div class="card-body">
                <form asp-controller="MOM_Department" asp-action="DepartmentFilter" method="post" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="DepartmentName" class="form-control" placeholder="Search by department name..." />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a asp-controller="MOM_Department" asp-action="DepartmentList" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </a>
                    </div>
                </form>
                @if (Model != null && Model.Count > 0)
                {
                <div class="table-responsive">
                    <table class="table table-striped" id="departmentsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Department Name</th>
                                <th>Remarks</th>
                                <th>Created</th>
                                <th>Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model)
                            {
                                <tr>
                                    <td>@dept.DepartmentID</td>
                                    <td>@dept.DepartmentName</td>
                                    <td>@dept.Remarks</td>
                                    <td>@dept.Created.ToString("yyyy-MM-dd")</td>
                                    <td>@dept.Modified.ToString("yyyy-MM-dd")</td>
                                    <td>
                                            <a asp-controller="MOM_Department" asp-action="DepartmentAddEdit" asp-route-id="@dept.DepartmentID" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                            <form asp-controller="MOM_Department" asp-action="DeleteDepartment" asp-route-id="@dept.DepartmentID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this department?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @* Error Message *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No departments found. Click "Add New Department" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>