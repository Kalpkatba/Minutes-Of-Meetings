@* @model MOM_MeetingMemberModel

<div class="row container-fluid">
    <div class="row-cols-lg-auto mx-auto">
        <div class="card shadow">
            <div class="card-header bg-theme-header fw-bold">
                <h4 class="card-title">
                    @(Model.MeetingMemberID == 0 ? "Add Meeting Member" : "Edit Meeting Member")
                </h4>
            </div>
            <div class="card-body">

                <form asp-controller="MeetingMember" asp-action="AddEdit" method="post">

                        <input type="hidden" name="MeetingMemberID" asp-for="MeetingMemberID" />

                    <div class="mb-3">
                        <label asp-for="MeetingDate" class="form-label">Meeting <span class="text-danger">*</span></label>
                        <select name="MeetingID" class="form-select" required>
                            <option value="">-- Select Meeting --</option>
                            @foreach (var meeting in Model)
                            {
                                var isSelected = member != null && member.MeetingID == meeting.MeetingID;
                                <option value="@meeting.MeetingID" selected="@isSelected">Meeting #@meeting.MeetingID - @meeting.MeetingDate.ToString("yyyy-MM-dd HH:mm")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Staff <span class="text-danger">*</span></label>
                        <select name="StaffID" class="form-select" required>
                            <option value="">-- Select Staff --</option>
                            @foreach (var staff in staffs)
                            {
                                var isSelected = member != null && member.StaffID == staff.StaffID;
                                <option value="@staff.StaffID" selected="@isSelected">@staff.StaffName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Is Present <span class="text-danger">*</span></label>
                        <select name="IsPresent" class="form-select" required>
                            @{
                                var isPresent = member?.IsPresent ?? true;
                            }
                            <option value="true" selected="@isPresent">Present</option>
                            <option value="false" selected="@(!isPresent)">Absent</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <textarea name="Remarks" class="form-control" maxlength="250">@(member?.Remarks ?? "")</textarea>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-theme fw-bold">Save</button>
                        <a asp-controller="MeetingMember" asp-action="MemberList" class="btn btn-danger fw-bold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}    *@