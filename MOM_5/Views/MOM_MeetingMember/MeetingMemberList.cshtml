@model List<MOM_MeetingMemberModel>


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title">Meeting Members</h4>
                    <a asp-controller="MOM_MeetingMember" asp-action="MeetingMemberAddEdit" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Member
                    </a>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search members...">
                    </div>
                    <div class="col-md-4">
                        <select id="filterMeeting" class="form-select">
                            <option value="">All Meetings</option>
                            @foreach (var meeting in Model)
                            {
                                <option value="@meeting.MeetingMemberID">Meeting #@meeting.MeetingMemberID</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select id="filterPresent" class="form-select">
                            <option value="">All</option>
                            <option value="true">Present</option>
                            <option value="false">Absent</option>
                        </select>
                    </div>
                </div>
                @if (Model != null && Model.Count > 0)
                {
                <div class="table-responsive">
                    <table class="table table-striped" id="membersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Meeting Date</th>
                                <th>Staff Name</th>
                                <th>DepartMent</th>
                                <th>Is Present</th>
                                <th>Remarks</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model)
                            {
                                <tr data-meeting="@member.MeetingID" data-present="@member.IsPresent.ToString().ToLower()">
                                    <td>@member.MeetingMemberID</td>
                                    <td>@member.MeetingDate</td>
                                    <td>@member.StaffName</td>
                                    <td>@member.DepartmentName</td>
                                    <td>
                                        @if (member.IsPresent)
                                        {
                                            <span class="badge bg-success">Present</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Absent</span>
                                        }
                                    </td>
                                    <td>@(member.Remarks ?? "N/A")</td>
                                    <td>
                                        <a asp-controller="MOM_MeetingMember" asp-action="MeetingMemberAddEdit" asp-route-id="@member.MeetingMemberID" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-controller="MOM_MeetingMember" asp-action="DeleteMeetingMember" asp-route-id="@member.MeetingMemberID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this member?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @* Error Message *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No Venue found. Click "Add New Venue" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
