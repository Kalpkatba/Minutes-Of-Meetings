<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=100%, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - MOM System</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/assets/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="~/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/assets/vendors/font-awesome/css/font-awesome.min.css">
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <link rel="stylesheet" href="~/assets/vendors/jvectormap/jquery-jvectormap.css">
    <link rel="stylesheet" href="~/assets/vendors/flag-icon-css/css/flag-icons.min.css">
    <link rel="stylesheet" href="~/assets/vendors/owl-carousel-2/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/vendors/owl-carousel-2/owl.theme.default.min.css">
    <!-- End plugin css for this page -->
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/assets/css/style.css">
    <!-- End layout styles -->
    <link rel="shortcut icon" href="~/assets/images/favicon.png" />
</head>
<body>
    <div class="container-scroller">
        @*<div class="row p-0 m-0 proBanner" id="pro~/Banner">
        <div class="col-md-12 p-0 m-0">
          <div class="card-body card-body-padding px-3 d-flex align-items-center justify-content-between">
            <div class="ps-lg-3">
              <div class="d-flex align-items-center justify-content-between">
                <p class="mb-0 font-weight-medium me-3 buy-now-text">Free 24/7 customer support, updates, and more with this template!</p>
                <a href="https://www.bootstrapdash.com/product/corona-admin-template/" target="_blank" class="btn me-2 buy-now-btn border-0">Buy Now</a>
              </div>
            </div>
            <div class="d-flex align-items-center justify-content-between">
              <a href="https://www.bootstrapdash.com/product/corona-admin-template/"><i class="mdi mdi-home me-3 text-white"></i></a>
              <button id="bannerClose" class="btn border-0 p-0">
                <i class="mdi mdi-close text-white"></i>
              </button>
            </div>
          </div>
        </div>
      </div> *@
        <!-- partial:partials/_sidebar.html -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            @{
                var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
            }
            <div class="sidebar-brand-wrapper d-none d-lg-flex align-items-center justify-content-center fixed-top">
                <a class="sidebar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-check system-logo" style="font-size: 2rem; margin-right: 10px;"></i>
                    <span class="system-title" style="font-weight: bold; font-size: 1.2rem;">MOM System</span>
                </a>
                <a class="sidebar-brand brand-logo-mini" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-check system-logo" style="font-size: 1.5rem;"></i>
                </a>
            </div>
            <ul class="nav">
                <li class="nav-item profile">
                    <div class="profile-desc" style="position: relative;">
                        <div class="profile-pic" id="sidebarProfileToggle" style="cursor: pointer;">
                            <div class="count-indicator">
                                <i class="bi bi-person-circle sidebar-user-icon" style="font-size: 2rem;"></i>
                                <span class="count bg-success"></span>
                            </div>
                            <div class="profile-name">
                                <h5 class="mb-0 font-weight-normal sidebar-user-name">@(User.Identity.Name ?? "User")</h5>
                            </div>
                        </div>
                        <div class="sidebar-profile-dropdown" id="sidebarProfileMenu" style="display: none; position: absolute; left: 0; right: 0; z-index: 999; background: #191c24; border-radius: 10px; box-shadow: 0 6px 20px rgba(0,0,0,0.3); overflow: hidden; margin-top: 5px;">
                            <a href="#" class="d-flex align-items-center px-3 py-2 text-decoration-none" style="color: #fff;" onmouseover="this.style.backgroundColor='rgba(25,135,84,0.2)'" onmouseout="this.style.backgroundColor='transparent'">
                                <i class="mdi mdi-cog text-success me-2"></i>
                                <span>Settings</span>
                            </a>
                            <a asp-controller="Login" asp-action="Login" class="d-flex align-items-center px-3 py-2 text-decoration-none" style="color: #fff;" onmouseover="this.style.backgroundColor='rgba(220,53,69,0.2)'" onmouseout="this.style.backgroundColor='transparent'">
                                <i class="mdi mdi-logout text-danger me-2"></i>
                                <span>Log Out</span>
                            </a>
                        </div>
                    </div>
                </li>
                <li class="nav-item nav-category">
                    <span class="nav-link">Navigation</span>
                </li>
                <li class="nav-item menu-items @(currentController == "Home" ? "active" : "")">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <span class="menu-icon">
                            <i class="mdi mdi-speedometer"></i>
                        </span>
                        <span class="menu-title">Dashboard</span>
                        <i class="menu-arrow"></i>
                    </a>
                </li>
                <li class="nav-item menu-items @(currentController == "MOM_Department" ? "active" : "")">
                    <a class="nav-link" asp-controller="MOM_Department" asp-action="DepartmentList">
                        <span class="menu-icon">
                            <i class="mdi mdi-laptop"></i>
                        </span>
                        <span class="menu-title">Departments</span>
                        <i class="menu-arrow"></i>
                    </a>
                </li>
                <li class="nav-item menu-items @(currentController == "MOM_MeetingType" ? "active" : "")">
                    <a class="nav-link" asp-controller="MOM_MeetingType" asp-action="MeetingTypeList">
                        <span class="menu-icon">
                            <i class="mdi mdi-table-large"></i>
                        </span>
                        <span class="menu-title">Meeting Type</span>
                        <i class="menu-arrow"></i>
                    </a>
                </li>
                <li class="nav-item menu-items @(currentController == "MOM_MeetingVenue" ? "active" : "")">
                    <a class="nav-link" asp-controller="MOM_MeetingVenue" asp-action="MeetingVenueList">
                        <span class="menu-icon">
                            <i class="mdi mdi-chart-bar"></i>
                        </span>
                        <span class="menu-title">Venues</span>
                        <i class="menu-arrow"></i>
                    </a>
                </li>
                <li class="nav-item menu-items @(currentController == "MOM_Staff" ? "active" : "")">
                    <a class="nav-link" asp-controller="MOM_Staff" asp-action="StaffList">
                        <span class="menu-icon">
                            <i class="mdi mdi-contacts"></i>
                        </span>
                        <span class="menu-title">Staff Members</span>
                        <i class="menu-arrow"></i>
                    </a>
                </li>
                <li class="nav-item menu-items @(currentController == "MOM_Meetings" && currentAction == "MeetingAddEdit" ? "active" : "")">
                    <a class="nav-link" asp-controller="MOM_Meetings" asp-action="MeetingAddEdit">
                        <span class="menu-icon">
                            <i class="mdi mdi-calendar-plus"></i>
                        </span>
                        <span class="menu-title">Schedule Meeting</span>
                    </a>
                </li>
                <li class="nav-item menu-items @(currentController == "MOM_Meetings" && currentAction == "MeetingList" ? "active" : "")">
                    <a class="nav-link" asp-controller="MOM_Meetings" asp-action="MeetingList">
                        <span class="menu-icon">
                            <i class="mdi mdi-calendar-multiple"></i>
                        </span>
                        <span class="menu-title">All Meetings</span>
                    </a>
                </li>

            </ul>
        </nav>
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <!-- partial:partials/_navbar.html -->
            <nav class="navbar p-0 fixed-top d-flex flex-row">
                <div class="navbar-brand-wrapper d-flex d-lg-none align-items-center justify-content-center">
                    <a class="navbar-brand brand-logo-mini" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-calendar-check" style="font-size: 1.5rem; color: #6f42c1;"></i>
                    </a>
                </div>
                <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
                    <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                        <span class="mdi mdi-menu"></span>
                    </button>
                    <ul class="navbar-nav w-100">
                        <li class="nav-item w-100">
                            <form class="nav-link mt-2 mt-md-0 d-none d-sm-flex search">
                                <input type="text" class="form-control" placeholder="Search">
                            </form>
                        </li>
                    </ul>
                    <ul class="navbar-nav navbar-nav-right">
                        <li class="nav-item">
                            <button id="themeToggleBtn" class="btn btn-sm" style="border: none; font-size: 1.3rem; background: transparent;">
                                <i class="bi bi-sun"></i>
                            </button>
                        </li>
                        <li class="nav-item" style="position: relative;">
                            <a class="nav-link d-flex align-items-center" id="navbarProfileToggle" href="#" style="cursor: pointer;">
                                <div class="navbar-profile d-flex align-items-center">
                                    <i class="bi bi-person-circle navbar-user-icon" style="font-size: 2rem;"></i>
                                    <p class="mb-0 d-none d-sm-block navbar-profile-name ms-2">@(User.Identity.Name ?? "User")</p>
                                </div>
                            </a>
                            <div id="navbarProfileMenu" style="display: none; position: absolute; right: 0; top: 100%; z-index: 9999; min-width: 200px; background: #191c24; border-radius: 10px; box-shadow: 0 8px 25px rgba(0,0,0,0.3); overflow: hidden;">
                                <div class="px-3 py-2" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                                    <h6 class="mb-0" style="color: #fff;">Profile</h6>
                                </div>
                                <a href="#" class="d-flex align-items-center px-3 py-2 text-decoration-none" style="color: #fff;" onmouseover="this.style.backgroundColor='rgba(25,135,84,0.2)'" onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="mdi mdi-cog text-success me-2"></i>
                                    <span>Settings</span>
                                </a>
                                <a asp-controller="Home" asp-action="Logout" class="d-flex align-items-center px-3 py-2 text-decoration-none" style="color: #fff;" onmouseover="this.style.backgroundColor='rgba(220,53,69,0.2)'" onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="mdi mdi-logout text-danger me-2"></i>
                                    <span>Log Out</span>
                                </a>
                            </div>
                        </li>
                    </ul>
                    <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                        <span class="mdi mdi-format-line-spacing"></span>
                    </button>
                </div>
            </nav>
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <!-- content-wrapper ends -->
                <!-- partial:partials/_footer.html -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Copyright © @DateTime.Now.Year MOM System. All rights reserved.</span>
                        <span class="text-muted float-none float-sm-end d-block mt-1 mt-sm-0 text-center">Minutes of Meeting Management System</span>
                    </div>
                </footer>
                <!-- partial -->
            </div>
            <!-- main-panel ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="~/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="~/assets/vendors/chart.js/chart.umd.js"></script>
    <script src="~/assets/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="~/assets/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/assets/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="~/assets/vendors/owl-carousel-2/owl.carousel.min.js"></script>
    <script src="~/assets/js/jquery.cookie.js" type="text/javascript"></script>
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="~/assets/js/off-canvas.js"></script>
    <script src="~/assets/js/misc.js"></script>
    <script src="~/assets/js/settings.js"></script>
    <script src="~/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="~/assets/js/proBanner.js"></script>
    <script src="~/assets/js/dashboard.js"></script>
    <!-- End custom js for this page -->
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // ── Theme Toggle ──
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = themeToggleBtn.querySelector('i');
            const currentTheme = localStorage.getItem('theme');

            if (currentTheme === 'light') {
                document.body.classList.add('light-mode');
                themeIcon.classList.replace('bi-sun', 'bi-moon');
            }

            themeToggleBtn.addEventListener('click', () => {
                document.body.classList.toggle('light-mode');
                if (document.body.classList.contains('light-mode')) {
                    localStorage.setItem('theme', 'light');
                    themeIcon.classList.replace('bi-sun', 'bi-moon');
                } else {
                    localStorage.setItem('theme', 'dark');
                    themeIcon.classList.replace('bi-moon', 'bi-sun');
                }
            });

            // ── Profile Dropdowns (vanilla JS – no Bootstrap dependency) ──
            const sidebarToggle = document.getElementById('sidebarProfileToggle');
            const sidebarMenu = document.getElementById('sidebarProfileMenu');
            const navbarToggle = document.getElementById('navbarProfileToggle');
            const navbarMenu = document.getElementById('navbarProfileMenu');

            function toggleMenu(menu) {
                const isOpen = menu.style.display === 'block';
                // Close all menus first
                sidebarMenu.style.display = 'none';
                navbarMenu.style.display = 'none';
                // Toggle the clicked one
                if (!isOpen) menu.style.display = 'block';
            }

            sidebarToggle.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                toggleMenu(sidebarMenu);
            });

            navbarToggle.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                toggleMenu(navbarMenu);
            });

            // Close dropdowns when clicking anywhere else
            document.addEventListener('click', () => {
                sidebarMenu.style.display = 'none';
                navbarMenu.style.display = 'none';
            });

            // Prevent closing when clicking inside the menu itself
            sidebarMenu.addEventListener('click', (e) => e.stopPropagation());
            navbarMenu.addEventListener('click', (e) => e.stopPropagation());
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>