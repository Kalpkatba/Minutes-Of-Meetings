@model MOM_MeetingVenueModel

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Add Meeting Venue</h4>

                <form asp-controller="MOM_MeetingVenue" asp-action="MeetingVenueAddEdit" method="post">
                    <div class="mb-3">
                        <label asp-for="MeetingVenueName" class="form-label">Venue Name <span class="text-danger">*</span></label>
                        <input type="text" name="MeetingVenueName" class="form-control"
                               value="@(Model?.MeetingVenueName ?? "")" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea name="remarks" class="form-control" rows="3" maxlength="500">@Model?.Remarks</textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Created" class="form-label">Created</label>
                        <textarea name="remarks" class="form-control" rows="3" maxlength="500" readonly>@Model.Created</textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Modified" class="form-label">Modified</label>
                        <textarea name="remarks" class="form-control" rows="3" maxlength="500" readonly>@Model.Modified</textarea>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="MOM_MeetingVenue" asp-action="MeetingVenueList" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}