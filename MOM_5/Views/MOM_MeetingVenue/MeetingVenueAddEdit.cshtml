@model MOM_MeetingVenueModel

<div class="row container-fluid">
    <div class="row-cols-lg-auto mx-auto">
        <div class="card shadow-lg">
            <div class="card-header bg-theme-header fw-bold">
                <h4 class="card-title">
                    @(Model.MeetingVenueID != 0 ? "Edit Meeting Venue" : "Add Meeting Venue")
                </h4>
            </div>
            <div class="card-body">

                <form asp-controller="MOM_MeetingVenue" asp-action="MeeitngVenueSave" method="post">

                    <input type="hidden" asp-for="MeetingVenueID" />

                    <div class="mb-3">
                        <label asp-for="MeetingVenueName" class="form-label">Venue Name <span class="text-danger">*</span></label>
                        <input asp-for="MeetingVenueName" class="form-control" maxlength="250" placeholder="Enter Meeting Type..." />
                        <span asp-validation-for="MeetingVenueName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" maxlength="500" placeholder="Enter Remarks">@Model?.Remarks</textarea>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-theme fw-bold">
                            <i class="fas fa-save"></i> @(Model.MeetingVenueID   > 0 ? "Update"
                                                        : "Save")
                        </button>
                        <a asp-controller="MOM_MeetingVenue" asp-action="MeetingVenueList" class="btn btn-danger fw-bold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}