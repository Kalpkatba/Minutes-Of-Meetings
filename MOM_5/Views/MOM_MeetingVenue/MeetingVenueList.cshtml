@model List<MOM_MeetingVenueModel>

<div class="row">
    <div class="col-12">
        <div class="card shadow-lg">
            <div class="card-header bg-theme-header d-flex justify-content-between align-items-center fw-bold">
                <h4 class="card-title mb-0 ps-2">Meeting Venues</h4>
                <a asp-controller="MOM_MeetingVenue" asp-action="MeetingVenueAddEdit" class="btn btn-theme-header fw-bold">
                    <i class="bi bi-plus-circle"></i> Add Venue
                </a>
            </div>
            <div class="card-body">

                @if (Model != null && Model.Count > 0)
                {
                    <div class="mb-3">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search departments...">
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped" id="departmentsTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Venue</th>
                                    <th>Remarks</th>
                                    <th>Created</th>
                                    <th>Modified</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var venue in Model)
                                {
                                    <tr>
                                        <td>@venue.MeetingVenueID</td>
                                        <td>@venue.MeetingVenueName</td>
                                        <td>@venue.Remarks</td>
                                        <td>@venue.Created.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@venue.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <a asp-controller="MOM_MeetingVenue" asp-action="MeetingVenueAddEdit" asp-route-id="@venue.MeetingVenueID" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <form asp-controller="MOM_MeetingVenue" asp-action="DeleteMeetingVenue" asp-route-id="@venue.MeetingVenueID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this department?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @* Error Message *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No Venue found. Click "Add New Venue" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
