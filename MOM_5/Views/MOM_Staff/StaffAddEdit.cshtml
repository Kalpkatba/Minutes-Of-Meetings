@model MOM_StaffModel

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Add Staff</h4>

                <form asp-controller="MOM_Staff" asp-action="StaffAddEdit" method="post">

                    <div class="mb-3">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select name="DepartmentID" class="form-select" asp-items="ViewBag.DepartmentList" required>
                            <option value="">-- Select Department --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Staff Name <span class="text-danger">*</span></label>
                        <input type="text" name="StaffName" class="form-control"
                               value="@(Model?.StaffName ?? "")" required maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mobile No <span class="text-danger">*</span></label>
                        <input type="text" name="MobileNo" class="form-control"
                               value="@(Model?.Mobile ?? "")" required maxlength="20" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="EmailAddress" class="form-control"
                               value="@(Model?.Email ?? "")" required maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <textarea name="Remarks" class="form-control" maxlength="250">@(Model?.Remarks ?? "")</textarea>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="MOM_Staff" asp-action="StaffList" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}