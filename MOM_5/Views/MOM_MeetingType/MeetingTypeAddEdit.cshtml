@model MOM_MeetingTypeModel

<div class="row container-fluid">
    <div class="row-cols-lg-auto mx-auto">
        <div class="card shadow-lg">
            <div class="card-header bg-theme-header fw-bold">
                <h4 class="card-title">
                    @(Model.MeetingTypeID != 0 ? "Edit Meeting Type" : "Add Meeting Type")
                </h4>
            </div>
            <div class="card-body">
                <form asp-controller="MOM_MeetingType" asp-action="MeetingTypeSave" method="post">

                        <input type="hidden" asp-for="MeetingTypeID" />

                    <div class="mb-3">
                        <label asp-for="MeetingTypeName" class="form-label">Meeting Type Name 
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="MeetingTypeName" type="text" name="MeetingTypeName" class="form-control" placeholder="Enter Meeting Type..." />
                        <span asp-validation-for="MeetingTypeName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea name="Remarks" class="form-control" rows="3" maxlength="500" placeholder="Enter Remarks...">@Model?.Remarks</textarea>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-theme fw-bold">
                        @(Model.MeetingTypeID == 0 ? "Save" : "Update")
                        </button>
                        <a asp-controller="MOM_MeetingType" asp-action="MeetingTypeList" class="btn btn-danger fw-bold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}