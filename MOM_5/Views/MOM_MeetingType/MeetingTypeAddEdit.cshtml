@* @model MOM_MeetingTypeModel

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">@(ViewBag.IsEdit == true ? "Edit Meeting Type" : "Add Meeting Type")</h4>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-controller="MeetingType" asp-action="MeetingTypeAddEdit" method="post">
                    @if (ViewBag.IsEdit == true && mt != null)
                    {
                        <input type="hidden" name="MeetingTypeID" value="@mt.MeetingTypeID" />
                    }

                    <div class="mb-3">
                        <label class="form-label">Meeting Type Name <span class="text-danger">*</span></label>
                        <input type="text" name="MeetingTypeName" class="form-control"
                               value="@(mt?.MeetingTypeName ?? "")" required maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Remarks <span class="text-danger">*</span></label>
                        <input type="text" name="Remarks" class="form-control"
                               value="@(mt?.Remarks ?? "")" required maxlength="100" />
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="MeetingType" asp-action="MeetingTypeList" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} *@