@model List<MOM_MeetingTypeModel>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title">Meeting Types</h4>
                    <a asp-controller="MOM_MeetingType" asp-action="MeetingTypeAddEdit" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Meeting Type
                    </a>
                </div>

                <div class="mb-3">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search meeting types...">
                </div>
                @if (Model != null && Model.Count > 0)
                {
                <div class="table-responsive">
                    <table class="table table-striped" id="meetingTypesTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Meeting Type Name</th>
                                <th>Remarks</th>
                                <th>Created</th>
                                <th>Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mt in Model)
                            {
                                <tr>
                                    <td>@mt.MeetingTypeID</td>
                                    <td>@mt.MeetingTypeName</td>
                                    <td>@mt.Remarks</td>
                                    <td>@mt.Created</td>
                                    <td>@mt.Modified</td>
                                    <td>
                                        <a asp-controller="MOM_MeetingType" asp-action="MeetingTypeAddEdit" asp-route-id="@mt.MeetingTypeID" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                            <form asp-controller="MOM_MeetingType" asp-action="DeleteMeetingType" asp-route-id="@mt.MeetingTypeID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this meeting type?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No Venue found. Click "Add New Venue" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

